# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/apimonitor?retryWrites=true&w=majority
# Make sure to include "apimonitor" database name before the "?"
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/apimonitor?retryWrites=true&w=majority

# Groq LLM API
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_MS=8000
AI_CONCURRENCY=3

# Anomaly Detection Thresholds
RESPONSE_TIME_THRESHOLD_MS=3000

# De-duplication Window (minutes)
DEDUP_WINDOW_MINUTES=10

# CORS Allowed Origin
CLIENT_ORIGIN=http://localhost:5173

# Optional Email Notification (nodemailer)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ALERT_EMAIL_FROM="API Monitor <your_email@gmail.com>"
ALERT_EMAIL_TO=receiver@example.com
